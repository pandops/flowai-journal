{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/journal/ui.dashboard.request.schema.json",
  "title": "journal.ui.dashboard request body (headers: team, operator_id, request_id, optional team_name)",
  "type": "object",
  "additionalProperties": false,
  "required": ["params"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "period"],
      "properties": {
        "team_id": {
          "$ref": "defs.schema.json#/$defs/id"
        },
        "period": {
          "enum": ["week", "month"]
        },
        "week": {
          "type": "string",
          "pattern": "^\\d{4}-W\\d{2}$"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "body": {
      "type": "null"
    }
  }
}
